{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "barRankings": {
      ".read": "auth != null",
      "$barId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['uid', 'displayName', 'barId', 'barName', 'neighborhood', 'choice', 'updatedAt']) && newData.child('uid').val() === auth.uid && (newData.child('choice').val() === 'like' || newData.child('choice').val() === 'pass') && (!newData.child('postText').exists() || (newData.child('postText').isString() && newData.child('postText').val().length <= 500))"
        }
      }
    },
    "barPostReactions": {
      ".read": "auth != null",
      "$postKey": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || (newData.child('uid').val() === auth.uid && (newData.child('type').val() === 'like' || newData.child('type').val() === 'dislike'))"
        }
      }
    },
    "barPostComments": {
      ".read": "auth != null",
      "$postKey": {
        "$commentId": {
          ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
          ".validate": "newData.hasChildren(['uid', 'displayName', 'text', 'createdAt']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500"
        }
      }
    }
  }
}
